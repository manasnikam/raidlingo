# Twitch developer console: Confidential client, Broadcaster Suite.
# Register this exact OAuth redirect URL: http://localhost:3000/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/callback

# Twitch logins, without https://twitch.tv/ or @. Leave placeholders to bind
# each seat to the broadcaster who authorizes it. Accounts must be different.
CHANNEL_A=<CHANNEL_A>
CHANNEL_B=<CHANNEL_B>
LANGUAGE_A=en
LANGUAGE_B=es

# Choose codex for your local ChatGPT-authenticated CLI, or openai for the API.
# Codex CLI must support --ignore-user-config (tested with 0.164.0).
# Run codex login first. The local provider uses your saved CLI authentication.
TRANSLATION_PROVIDER=codex
CODEX_BIN=codex
# Leave blank to use the CLI's built-in default model.
CODEX_TRANSLATE_MODEL=
CODEX_TIMEOUT_MS=20000
# Required only when TRANSLATION_PROVIDER=openai (server only).
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# A separate Twitch account that will post translations. Optional expected login.
# Connect it via the Relay Bot button after connecting seats A and B.
BOT_CHANNEL=
OVERLAY_LANGUAGE=en

# Voice implementation starts in phase 3; this setting is configuration-only today.
VOICE_MODE=realtime
STREAM_HINTS=Twitch,Raidlingo

HOST=127.0.0.1
PORT=3000
SEAT_URL=http://localhost:5173
OVERLAY_URL=http://localhost:5174
# Tokens stay on disk locally (0600). Never commit or share this folder.
TOKEN_STORE_PATH=.data/twitch-tokens.json
LOG_LEVEL=info
